# Shared app database. Apply migrations only from coledia_app_1.0/packages/db.
DATABASE_URL="mysql://user:password@localhost:3306/coledia"

# Use the same secret as the app; set a distinct URL for this website.
# Generate a strong secret of at least 32 characters. Never set TENANT_ID here.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Host-only sessions: owners use the same credentials but sign in on each domain.
# Verification is always required in production. Development may opt in here.
AUTH_REQUIRE_EMAIL_VERIFICATION="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Explicit local simulation only; ignored in production. No live app is deployed.
CONTROL_CENTER_MOCK_PROVISIONING="false"
CONTAINER_BASE_DOMAIN="coledia.com"

# Phase 2: Dokploy container provisioning.
# When all three are set, real provisioning is used. Otherwise mock/error behavior applies.
DOKPLOY_API_URL=""
DOKPLOY_API_KEY=""
DOKPLOY_ENVIRONMENT_ID=""
# Git source for building the Coledia app in each container.
DOKPLOY_GIT_URL=""
DOKPLOY_GIT_BRANCH="main"
DOKPLOY_GIT_BUILD_PATH=""
DOKPLOY_DOCKERFILE="Dockerfile"
DOKPLOY_DOCKER_CONTEXT_PATH=""
DOKPLOY_CONTAINER_PORT="3000"

# Phase 3: Stripe owner-tier billing.
# Use test-mode keys (sk_test_...) for development.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_CLUB=""
STRIPE_PRICE_ORGANIZATION=""
